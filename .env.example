# Merge needed lines into the existing ignored .env; do not overwrite it.
# Owner-only H05. Keep Cloudflare on its free plan with no card.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Separate server-side pipeline signing key, at least 32 random characters.
ATLAS_INGEST_HMAC_KEY=
# Owner-only H06. Fine-grained token scoped to the archive dataset repository only.
HF_TOKEN=
# The archive dataset repository id (owner/name); not a secret, kept out of git.
HF_ARCHIVE_REPO=
