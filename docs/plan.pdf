      -o requirements/core.txt
    - ".\\.venv\\Scripts\\python -m pip install --require-hashes -r requirements/core.txt"
    - >-
      .\.venv\Scripts\python -m piptools compile --generate-hashes requirements/dev.in
      -o requirements/dev.txt
    - ".\\.venv\\Scripts\\python -m pip install --require-hashes -r requirements/dev.txt"
    - ".\\.venv\\Scripts\\python -m pip install --no-deps -e ."
    - ".\\.venv\\Scripts\\python -m pip check"
    - ".\\.venv\\Scripts\\python -m ruff check ."
    - ".\\.venv\\Scripts\\python -m ruff format --check ."
    - ".\\.venv\\Scripts\\python -m pytest tests/test_environment.py -q"
  acceptance:
    command: ".\\.venv\\Scripts\\python -m pytest tests/test_environment.py -q"
    expected: >-
