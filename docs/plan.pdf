- id: T189
  title: "News annotation batch01:50 real articles"
  phase: "P5"
  state: "KL"
  depends_on:
    - "T126"
  files:
    - "eval/news/batch_01.jsonl"
    - "reports/labels/news_01.md"
    - "tests/labels/test_news_01.py"
  steps:
    - >-
      Select50 permitted deduplicated real articles from the frozen temporal split;track
      article hash,publisher,date and language.
    - >-
      Manually label event class,public place,event date and evidence span;review10%
      twice and adjudicate disagreements. Exclude personal information.
    - >-
      Record annotation minutes and uncertain cases;require50 completed labelled records
      for this batch,otherwise carry remaining work into another bounded task.
  commands:
    - ".\\.venv\\Scripts\\python -m pytest tests/labels/test_news_01.py -q"
  acceptance:
    command: ".\\.venv\\Scripts\\python -m pytest tests/labels/test_news_01.py -q"
    expected: >-
      50 real records with gold evidence,language/date/place labels and review flags;no
      synthetic article or test-set leakage.
  hours: 3
