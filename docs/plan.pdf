  phase: "P3"
  state: "KL"
  depends_on:
    - "T110"
  files:
    - "configs/sources/s34.yaml"
    - "docs/sources/s34.md"
    - "tests/fixtures/s34/manifest.json"
    - "tests/sources/test_s34_discovery.py"
  steps:
    - >-
      Use https://sdma.kerala.gov.in/dam-water-level; resolve only links actually
      published by the source. Record URL, access time, licence text, sample format,
      provider quota and earliest/latest date.
    - >-
      Apply source-specific check: Sample-check all columns and date; require manual
      review for OCR before model use.
    - >-
      Write outcome available/blocked with evidence, upstream-to-canonical field map and
      no-card status. If blocked, disable dependents and record retry condition, never
      invent endpoints or data. Bound discovery to 2 hours.
  commands:
    - ".\\.venv\\Scripts\\python -m pytest tests/sources/test_s34_discovery.py -q"
  acceptance:
    command: ".\\.venv\\Scripts\\python -m pytest tests/sources/test_s34_discovery.py -q"
    expected: >-
      Discovery contract passes only with cited evidence and explicit
      access/licence/history status; blocked is a discovery result, not data or feature
      completion.
  hours: 2
