{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "rain",
  "position": {
    "x": 240,
    "y": 110,
    "z": 3000,
    "width": 1016,
    "height": 480,
    "tabOrder": 3000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "District Rain"
                    }
                  },
                  "Property": "district"
                }
              },
              "queryRef": "District Rain.district",
              "nativeQueryRef": "district"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "District Rain"
                    }
                  },
                  "Property": "Mean Annual Rain"
                }
              },
              "queryRef": "District Rain.Mean Annual Rain",
              "nativeQueryRef": "Mean Annual Rain"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Mean annual rain at the gauges, mm'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ]
    }
  }
}
