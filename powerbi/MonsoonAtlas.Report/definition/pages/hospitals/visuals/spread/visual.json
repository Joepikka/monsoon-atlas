{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "spread",
  "position": {
    "x": 440,
    "y": 220,
    "z": 8000,
    "width": 420,
    "height": 236,
    "tabOrder": 8000
  },
  "visual": {
    "visualType": "scatterChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Hospital Access"
                    }
                  },
                  "Property": "district"
                }
              },
              "queryRef": "Hospital Access.district",
              "nativeQueryRef": "district"
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Hospital Access"
                    }
                  },
                  "Property": "Mean km"
                }
              },
              "queryRef": "Hospital Access.Mean km",
              "nativeQueryRef": "Mean km"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Hospital Access"
                    }
                  },
                  "Property": "Share Beyond 10 km"
                }
              },
              "queryRef": "Hospital Access.Share Beyond 10 km",
              "nativeQueryRef": "Share Beyond 10 km"
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Hospital Access"
                    }
                  },
                  "Property": "District People"
                }
              },
              "queryRef": "Hospital Access.District People",
              "nativeQueryRef": "District People"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Mean km against share over 10 km (size: people)'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ]
    }
  }
}
