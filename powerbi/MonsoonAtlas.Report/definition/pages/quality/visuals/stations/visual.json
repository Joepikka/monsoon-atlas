        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Gauge Stations"
                    }
                  },
                  "Property": "Gauge Count"
                }
              },
              "queryRef": "Gauge Stations.Gauge Count",
