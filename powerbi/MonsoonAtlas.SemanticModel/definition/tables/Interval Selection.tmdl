	partition 'Interval Selection' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "interval_selection.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"window_years", Int64.Type}, {"by_season", type text}, {"coverage_2010_2019", type number}, {"mean_width", type number}, {"chosen", type text}}, "en-US")
				in
				    Typed
