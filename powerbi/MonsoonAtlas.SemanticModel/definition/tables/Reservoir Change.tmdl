table 'Reservoir Change'
	lineageTag: 36d11bd1-d421-50d5-aa70-b53656ae35f2

	measure 'Storage Change' = AVERAGE('Reservoir Change'[change_points])
		formatString: +0.0;-0.0;0.0
		lineageTag: fcc34fe0-4f50-59e2-848f-f43e273a51e4

	column window
		dataType: string
		lineageTag: 54c1b0a2-41cf-555c-9276-90dc9d56ba8f
		summarizeBy: none
		sourceColumn: window

	column reservoir
		dataType: string
		lineageTag: 0e336691-e415-5a71-ac57-9b3ccf8d2cf2
		summarizeBy: none
		sourceColumn: reservoir

	column start_pct
		dataType: double
		formatString: 0.000
		lineageTag: 9ff61c64-4e6d-5424-80be-2cf97a5d567a
		summarizeBy: none
		sourceColumn: start_pct

	column end_pct
		dataType: double
		formatString: 0.000
		lineageTag: 5a51992d-522b-5981-a743-466b6f79806f
		summarizeBy: none
		sourceColumn: end_pct

	column change_points
		dataType: double
		formatString: 0.000
		lineageTag: 3367fc5f-7baf-50c4-9671-703cbe6d5209
		summarizeBy: none
		sourceColumn: change_points

	partition 'Reservoir Change' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "reservoir_change.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"window", type text}, {"reservoir", type text}, {"start_pct", type number}, {"end_pct", type number}, {"change_points", type number}}, "en-US")
				in
				    Typed
