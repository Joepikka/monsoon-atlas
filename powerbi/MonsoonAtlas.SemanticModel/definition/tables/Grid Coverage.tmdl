table 'Grid Coverage'
	lineageTag: 36a475df-a5e2-590d-9297-3b556f82f3f0

	measure 'Grid Completeness' = AVERAGE('Grid Coverage'[share])
		formatString: 0.0%
		lineageTag: 56e5d305-0802-58c3-96ae-b8c04d888729

	column year
		dataType: int64
		formatString: 0
		lineageTag: 061a06e6-5ec8-5c75-a95a-85b01ad25b59
		summarizeBy: none
		sourceColumn: year

	column month
		dataType: int64
		formatString: 0
		lineageTag: a5247359-f539-51ed-afac-6a9c14832042
		summarizeBy: none
		sourceColumn: month

	column share
		dataType: double
		formatString: 0.000
		lineageTag: 1ec77ac6-0e69-5fbb-aef7-2b43d1b7b1b2
		summarizeBy: none
		sourceColumn: share

	partition 'Grid Coverage' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "grid_coverage.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"year", Int64.Type}, {"month", Int64.Type}, {"share", type number}}, "en-US")
				in
				    Typed
